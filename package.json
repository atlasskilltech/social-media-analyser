{
  "name": "social-media-analyserv2",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright scrapers for four fixed public social media pages. Writes cache/*.json for the PHP dashboard to display.",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server.js",
    "instagram": "node instagram.js",
    "youtube": "node youtube.js",
    "facebook": "node facebook.js",
    "linkedin": "node linkedin.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "vite": "^8.2.0"
  }
}
