# Meta Graph API — required for Instagram and Facebook
#
# Copy to .env.local and fill in. .env.local is git-ignored and must never be
# committed: the access token grants read access to the Page and its linked
# Instagram Business account.

# Page access token. A non-expiring Page token is recommended so no refresh
# flow is needed. Required scopes: instagram_basic, pages_read_engagement,
# pages_show_list.
META_ACCESS_TOKEN=

# The Instagram Business account id linked to the Page.
META_INSTAGRAM_BUSINESS_ID=

# The Facebook Page id.
META_FACEBOOK_PAGE_ID=

# Graph API version.
META_GRAPH_VERSION=v21.0
